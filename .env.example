# ============================================================
# AI-Based Warehouse Slot Utilization Analyzer
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# ──────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────
APP_NAME="Warehouse Slot Analyzer"
APP_ENV=development          # development | production
APP_PORT=8000
DEBUG=true

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ──────────────────────────────────────────────
# Database (Azure SQL or SQLite for local dev)
# ──────────────────────────────────────────────
# Local development (SQLite — no credentials needed)
DATABASE_URL=sqlite:///./warehouse.db

# Azure SQL Database (production)
# DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server

# ──────────────────────────────────────────────
# Azure Blob Storage
# ──────────────────────────────────────────────
# Leave blank in local dev — uploads go to local ./uploads folder
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=warehouse-datasets

# ──────────────────────────────────────────────
# Azure Application Insights (optional)
# ──────────────────────────────────────────────
AZURE_APPINSIGHTS_CONNECTION_STRING=

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ──────────────────────────────────────────────
# File Upload Limits
# ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv

# ──────────────────────────────────────────────
# Pagination
# ──────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
